{
  "name": "velopulse-dashboard",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "i18n:check": "node scripts/check-i18n-keys.mjs",
    "i18n:check:strict": "node scripts/check-i18n-keys.mjs --strict",
    "schema:build": "node scripts/build-schema.mjs",
    "schema:check": "node scripts/build-schema.mjs --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "commit:check": "node scripts/check-commit-msg.mjs --range",
    "changelog": "node scripts/gen-changelog.mjs",
    "changelog:write": "node scripts/gen-changelog.mjs --write",
    "hooks:install": "node scripts/setup-git-hooks.mjs",
    "hooks:uninstall": "node scripts/setup-git-hooks.mjs --uninstall",
    "prepare": "node scripts/setup-git-hooks.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.103.0",
    "@tanstack/react-query": "^5.99.0",
    "bcryptjs": "^3.0.3",
    "jszip": "^3.10.1",
    "lucide-react": "^1.8.0",
    "motion": "^13.1.1",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.8.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/web-bluetooth": "^0.0.21",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.1.14",
    "typescript": "6.0.2",
    "vitest": "^4.1.4"
  }
}
